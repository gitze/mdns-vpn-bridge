#!/bin/sh /etc/rc.common
# mdns-vpn-bridge — procd service for OpenWrt / Teltonika RutOS.
# Configuration lives in /etc/config/mdns-vpn-bridge (UCI).
USE_PROCD=1
START=95
STOP=10

PROG="/usr/local/bin/mdns-vpn-bridge"
CONFIG="mdns-vpn-bridge"

# reject_injection rejects UCI values that could smuggle an extra flag or split
# an argument: a leading '-' (looks like a flag) or embedded whitespace. The
# WebUI writes some of these values, so validate before handing them to procd.
reject_injection() { # name value
	case "$2" in
		""|-*|*[[:space:]]*)
			echo "mdns-vpn-bridge: refusing invalid $1 '$2'" >&2
			return 1
			;;
	esac
	return 0
}

start_service() {
	config_load "$CONFIG"

	local enabled lan_if peer peerport linkbind lan2peer peer2lan services stats status_addr
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || {
		echo "mdns-vpn-bridge: disabled (uci set mdns-vpn-bridge.main.enabled=1)" >&2
		return 0
	}

	config_get lan_if main lan_if "br-lan"
	config_get peer main peer ""
	config_get peerport main peerport "53530"
	config_get linkbind main linkbind ""
	config_get lan2peer main lan2peer "all"
	config_get peer2lan main peer2lan "all"
	config_get services main services ""
	config_get stats main stats "300s"
	config_get status_addr main status_addr "127.0.0.1:53531"

	if [ -z "$peer" ]; then
		echo "mdns-vpn-bridge: no peer configured (uci set mdns-vpn-bridge.main.peer=<overlay-ip>)" >&2
		return 1
	fi

	reject_injection peer "$peer" || return 1
	reject_injection lan_if "$lan_if" || return 1
	if [ -n "$linkbind" ]; then
		reject_injection linkbind "$linkbind" || return 1
	fi

	# Each value is passed as its own quoted argument: no shell word-splitting,
	# so a UCI value can never introduce a second flag.
	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command -lan "$lan_if"
	procd_append_param command -peer "$peer"
	procd_append_param command -peerport "$peerport"
	procd_append_param command -lan2peer "$lan2peer"
	procd_append_param command -peer2lan "$peer2lan"
	procd_append_param command -stats "$stats"
	procd_append_param command -status "$status_addr"
	if [ -n "$linkbind" ]; then
		procd_append_param command -linkbind "$linkbind"
	fi
	if [ -n "$services" ]; then
		procd_append_param command -services "$services"
	fi
	procd_set_param respawn 3600 5 0
	procd_set_param limits core="0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
