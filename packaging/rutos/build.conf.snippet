# Add to [apps] in the RutOS SDK build.conf (tested with RUTX_R_SDK_00.07.26.1):

mdns-vpn-bridge.enabled = true
mdns-vpn-bridge.ship = true
mdns-vpn-bridge.enable-init = mdns-vpn-bridge
mdns-vpn-bridge.version = 0.1.0
mdns-vpn-bridge.architecture = cortexa7hf-neon-vfpv4
mdns-vpn-bridge.description = mDNS/Bonjour relay between two LANs over a unicast VPN link
mdns-vpn-bridge.section = net
mdns-vpn-bridge.maintainer = mdns-vpn-bridge contributors
