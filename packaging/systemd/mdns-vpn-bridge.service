[Unit]
Description=mDNS VPN bridge — mDNS/Bonjour relay between two LANs over a unicast overlay
Documentation=https://github.com/gitze/mdns-vpn-bridge
Documentation=file:/usr/share/doc/mdns-vpn-bridge/configuration.md
After=network-online.target
Wants=network-online.target
# If the overlay runs as its own service (e.g. tailscaled), add it here so the
# bridge starts after it:
# After=tailscaled.service

[Service]
Type=simple
# Configuration lives in a single JSON file (see docs/configuration.md). The
# file is read once at startup; there is no hot reload, so a change needs
# `systemctl restart mdns-vpn-bridge`. Install it as root:root mode 0644 (it
# holds no secrets), which is what DynamicUser/ProtectSystem below can read.
#
# ExecStart takes ONLY -config: no per-setting flags, so the file is the single
# source of truth. (CLI flags would override the file; keeping ExecStart bare
# avoids drift.) The relay validates before binding sockets; exit 2 means
# invalid configuration/arguments and must not cause an endless restart loop.
ExecStart=/usr/local/bin/mdns-vpn-bridge -config /etc/mdns-vpn-bridge/config.json
Restart=always
RestartPreventExitStatus=2
RestartSec=5

# Hardening. The mDNS port (5353) and the status port are both above 1024, so
# the relay needs no privileges: it runs as a transient, dynamically allocated
# user with an empty capability set.
#
# AF_NETLINK is required in addition to AF_INET: the Go net package enumerates
# interfaces and addresses over route netlink. Restricting to "AF_INET AF_UNIX"
# makes the relay fail at startup with
# "netlinkrib: address family not supported by protocol" (verified on Debian 13,
# systemd 257).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
